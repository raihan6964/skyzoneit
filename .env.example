# --- Supabase (Project Settings -> API) ---
# If you connect Supabase via the Vercel integration, it may inject
# SUPABASE_URL / SUPABASE_ANON_KEY instead — the app accepts both
# (see next.config.ts env normalization).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI review generation (Groq: https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Screenshot / banner hosting (https://api.imgbb.com/) ---
IMGBB_API_KEY=your-imgbb-key

# --- Google Apps Script Web App URL (deploy Code.gs -> New deployment -> Web app) ---
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# --- Python verification service (separate Vercel project, see python-service/README.md) ---
# Root URL only — the app calls <URL>/verify with the x-secret header.
PYTHON_SERVICE_URL=https://your-python-service.vercel.app
PYTHON_SERVICE_SECRET=long-random-string

# --- Vercel Cron protection (Vercel sends "Authorization: Bearer $CRON_SECRET" to cron paths) ---
CRON_SECRET=another-long-random-string

# --- Optional: this email is treated as admin even if the profile role is "user" ---
ADMIN_EMAIL=you@example.com
